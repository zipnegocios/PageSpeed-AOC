FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build && pnpm migrate:build

FROM node:22-slim AS run
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
# Tope del heap de Node: el VPS es compartido. Next + generación de PDF caben de sobra; ajusta con NODE_OPTIONS en EasyPanel.
ENV NODE_OPTIONS=--max-old-space-size=512
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# Migraciones de Drizzle: se aplican antes de servir tráfico.
COPY --from=build /app/dist/migrate-cli.cjs ./migrate-cli.cjs
# Restauración de respaldos (se ejecuta a mano desde la consola del servicio; ver docs/runbook.md).
COPY --from=build /app/dist/restore-cli.cjs ./restore-cli.cjs
# Correos de prueba al cliente con datos de ejemplo (se ejecuta a mano desde la consola del servicio: node send-test-emails-cli.cjs <correo>).
COPY --from=build /app/dist/send-test-emails-cli.cjs ./send-test-emails-cli.cjs
COPY --from=build /app/drizzle ./drizzle
EXPOSE 3000
# Solo comprueba que el proceso responde (no mira la base: una caída de Postgres no debe reiniciar el web).
# Margen amplio al inicio porque las migraciones corren antes de servir.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/login').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["sh", "-c", "node migrate-cli.cjs && exec node server.js"]
