# Imagen del worker: Node + Chromium del sistema (Lighthouse corre sobre él). Réplicas = 1.
FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm worker:build

FROM node:22-bookworm-slim AS run
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji dumb-init \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production CHROME_PATH=/usr/bin/chromium
COPY --from=build /app/dist/worker ./dist/worker
USER node
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "--max-old-space-size=512", "dist/worker/index.js"]
