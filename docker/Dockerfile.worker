# Imagen del worker: Node + Chromium del sistema (Lighthouse corre sobre él). Réplicas = 1.
# Solo lleva las dependencias que el worker usa (se calculan en scripts/worker-manifest.mjs).
FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Compila el código y genera dist/worker/package.json; luego instala solo esas dependencias.
RUN pnpm worker:build \
 && cd dist/worker \
 && npm install --omit=dev --no-audit --no-fund --loglevel=error

FROM node:22-bookworm-slim AS run
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji ca-certificates dumb-init \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production CHROME_PATH=/usr/bin/chromium
COPY --from=build --chown=node:node /app/dist/worker ./
USER node
ENTRYPOINT ["dumb-init", "--"]
# --max-old-space-size limita el Node del worker; Chromium es un proceso aparte (límite del contenedor).
CMD ["node", "--max-old-space-size=512", "index.js"]
