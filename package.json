{
  "name": "pagespeed",
  "author": "zipnegocios (Gustavo Amarista)",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-lighthouse-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:build": "tsup src/worker/index.ts --format esm --target node22 --out-dir dist/worker --clean && node scripts/worker-manifest.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "migrate:build": "tsup --config tsup.migrate.config.ts",
    "contrast:check": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-pdf/renderer": "^4.9.0",
    "bullmq": "^6.5.3",
    "chrome-launcher": "^1.2.2",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^12.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "lighthouse": "^13.6.0",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "server-only": "^0.0.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^3"
  }
}
