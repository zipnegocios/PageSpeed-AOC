{
  "name": "aoc-pagespeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:build": "tsup src/worker/index.ts --format esm --target node22 --out-dir dist/worker --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.4",
    "pg": "^8.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^3"
  }
}
