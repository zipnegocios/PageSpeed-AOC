# Copia este archivo a .env.spike (en la raíz del repo; está en .gitignore) y completa los valores.
# NUNCA subas .env.spike, la llave JSON ni la carpeta de salida. Estas variables no son las de producción.

# Llave JSON de la cuenta de servicio (guárdala FUERA del repo). Sirve para GSC y GA4.
SPIKE_GSC_KEY_FILE=/ruta/fuera/del/repo/cuenta-servicio.json

# Propiedad de Search Console: "sc-domain:ejemplo.com" (dominio) o "https://ejemplo.com/" (prefijo de URL).
SPIKE_GSC_SITE=sc-domain:ejemplo.com
# "final" solo trae días cerrados; "all" incluye los más recientes (útil para medir el retraso).
SPIKE_GSC_DATA_STATE=final

# ID NUMÉRICO de la propiedad de GA4 (Administrador > Detalles de la propiedad), no el ID de medición G-XXXX.
SPIKE_GA4_PROPERTY=123456789

# Cloudflare: token de solo lectura con permiso de analíticas de la zona, y el ID de zona.
SPIKE_CF_TOKEN=
SPIKE_CF_ZONE=

# Sitio a rastrear (40-crawl.ts).
SPIKE_SITE_URL=https://ejemplo.com

# Idiomas por prefijo de ruta: "idioma=/prefijo,idioma=/prefijo". El idioma sin prefijo, si lo hay, va aparte.
SPIKE_LANGS=es=/es,en=/en
SPIKE_LANG_DEFAULT=

# Ventana de datos: días a pedir y días de retraso que se dejan fuera al final.
SPIKE_DAYS=28
SPIKE_LAG_DAYS=3

# Carpeta de salida (por defecto .spike/, ignorada por git). Si la cambias, que quede fuera del repo.
# SPIKE_OUT_DIR=.spike

# Sondeo de IA (50-probe.ts): una clave por proveedor que quieras probar. Cada llamada cuesta dinero.
# SPIKE_ANTHROPIC_API_KEY=
# SPIKE_OPENAI_API_KEY=
# SPIKE_GEMINI_API_KEY=
# SPIKE_PERPLEXITY_API_KEY=
# Modelo por defecto de cada proveedor (opcional): SPIKE_ANTHROPIC_MODEL, SPIKE_OPENAI_MODEL, SPIKE_GEMINI_MODEL, SPIKE_PERPLEXITY_MODEL.
# País (ISO de dos letras) para orientar la búsqueda donde la API lo admita, por ejemplo CO o VE. Es aproximado.
# SPIKE_PROBE_COUNTRY=
