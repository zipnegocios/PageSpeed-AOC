# =====================================================================
# AOC PageSpeed — variables de entorno
# Copia a .env en local. En EasyPanel se cargan en cada servicio (web y worker).
# Los secretos reales NUNCA van en el repositorio.
# Columna "Dónde": W = servicio web, K = servicio worker, W+K = ambos.
# =====================================================================

# --- App -------------------------------------------------------------
NODE_ENV=development                      # W+K
# URL pública del web (links mágicos y enlaces de emails). Producción: https://tu-dominio
APP_URL=http://localhost:3000             # W+K
LOG_LEVEL=info                            # W+K  (debug | info | warn | error)

# --- Seguridad -------------------------------------------------------
# Firma de la cookie de sesión del admin. Mínimo 32 caracteres: openssl rand -base64 48
SESSION_SECRET=
# Cifra las credenciales de login de sitios auditados (AES-256-GCM). 32 bytes en base64:
#   openssl rand -base64 32
AUTH_ENCRYPTION_KEY=                      # W+K

# --- Admin único (solo se usa para crear la cuenta en el primer arranque) ---
ADMIN_EMAIL=                              # W
ADMIN_PASSWORD=                           # W  (mínimo 12 caracteres)

# --- PostgreSQL (migraciones con Drizzle ORM al arrancar el web) -------
# EasyPanel: crea un servicio Postgres y usa su "connection string interna".
DATABASE_URL=postgres://aoc:aoc@localhost:5432/aoc   # W+K

# --- Redis (cola BullMQ) ---------------------------------------------
# EasyPanel: servicio Redis con maxmemory-policy=noeviction y AOF activado.
REDIS_URL=redis://localhost:6379          # W+K

# --- Cloudflare R2 (JSON de auditorías, bucket "reportes") ------------
# Endpoint "S3 API" de R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000         # W+K  (local: MinIO)
R2_REGION=auto
R2_BUCKET=reportes                        # en local con MinIO: crea un bucket con este nombre
R2_ACCESS_KEY_ID=minioadmin               # W+K
R2_SECRET_ACCESS_KEY=minioadmin           # W+K

# --- Email (SMTP) ----------------------------------------------------
# Local: Mailpit (docker-compose). Producción: tu proveedor SMTP.
SMTP_HOST=localhost                       # W+K
SMTP_PORT=1025                            # W+K  (587 STARTTLS / 465 TLS)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AOC PageSpeed <no-reply@localhost>

# --- Worker (solo servicio worker) -----------------------------------
# Ruta de Chromium; la imagen Docker del worker ya fija /usr/bin/chromium.
CHROME_PATH=
# Pausa tras cada auditoría para no saturar el VPS (ms)
AUDIT_COOLDOWN_MS=12000
# Tiempo máximo por auditoría (ms)
AUDIT_TIMEOUT_MS=90000
# Intentos totales por auditoría (1 original + reintentos)
AUDIT_ATTEMPTS=3
