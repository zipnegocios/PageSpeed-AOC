# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Admin único (hash bcrypt/scrypt se definirá en M1); clave de firma de sesión (>= 32 chars)
SESSION_SECRET=change-me-change-me-change-me-change-me
# Clave AES-256-GCM (32 bytes en base64) para credenciales de login de sitios auditados
AUTH_ENCRYPTION_KEY=

# --- Datos ---
DATABASE_URL=postgres://aoc:aoc@localhost:5432/aoc
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (en dev: MinIO de docker-compose) ---
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_BUCKET=aoc-pagespeed
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin

# --- Email (SMTP; en dev: Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AOC PageSpeed <no-reply@localhost>

# --- Worker ---
CHROME_PATH=
AUDIT_COOLDOWN_MS=12000
AUDIT_TIMEOUT_MS=90000
AUDIT_ATTEMPTS=3
